# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Clerk (https://dashboard.clerk.com) — create a dev/test application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/dpstore/store/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/dpstore/store/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=https://allibuild.com
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=https://allibuild.com
NEXT_PUBLIC_BASE_PATH=/dpstore

# Admin account allowed to use the dashboard and admin API routes.
ADMIN_EMAIL=lucian.virtic@gmail.com

# Product imports — Airtable Products table and Google Cloud Storage.
AIRTABLE_API_KEY=pat_xxxxxxxx
AIRTABLE_BASE_ID=app_xxxxxxxx
AIRTABLE_PRODUCTS_TABLE=Products
GOOGLE_CLOUD_PROJECT=g-hub-393209
GOOGLE_CLOUD_STORAGE_BUCKET=dpstore-public
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Stripe (https://dashboard.stripe.com/test/apikeys) — test mode keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Resend mail service
RESEND_FROM_EMAIL="DigitalPulse Store <onboarding@resend.dev>"
